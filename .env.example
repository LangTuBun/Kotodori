# Copy to .env and adjust if 8080 is already taken on your host.
TORI_PORT=8080

# How many CPU threads VOICEVOX uses per synthesis request. Left unset, it
# defaults to half this VM's visible logical cores -- on a small VM (1-2
# vCPUs) that's a single thread, and is usually why pronunciation feels slow.
# Find your VM's core count with `nproc` and set this at or just under it.
# VOICEVOX_THREADS=4
